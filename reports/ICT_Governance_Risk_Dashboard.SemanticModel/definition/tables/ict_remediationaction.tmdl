				    Step5 = Table.AddColumn(Step4, "_x5", each let v=Pick(_,{"Priority", "ict_priorityname", "ict_priority"}) in if v=null then null else if Text.From(v)="823140000" then "Critical" else if Text.From(v)="823140001" then "High" else if Text.From(v)="823140002" then "Medium" else if Text.From(v)="823140003" then "Low" else Text.From(v), type text),
